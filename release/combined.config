# OperaLibre release settings.
#
# This package stores its library and data beside the server executable.
# You can replace these with absolute paths at any time.

# Choose local, lan, or proxy. The profile selects a safe default host;
# advanced deployments can override it with `host`.
deployment_mode = local
host =
port = 4920
allowed_origins =
max_upload_gib = 20
max_book_download_gib = 25
max_concurrent_book_downloads = 1
# ZIPs are staged here only while a client downloads them. Keep at least this
# much capacity free before starting another archive. Uncomment to override.
# While these lines stay commented, staging is `download-temp` inside
# `data_dir` and the free-space reserve is 2 GiB.
# download_temp_dir = data/download-temp
# min_download_free_gib = 2

library_root = audiobooks
data_dir = data
progress_file = data/progress.json
users_file = data/users.json

# Serve the included web app from the same address as the server. Leave it
# empty to run the server only, for a separately hosted frontend or another
# client; in-app updates then leave the web folder alone.
web_dist_dir = web

# Optional Libation / Audible import.
libation_cli_path =
libation_files_dir =
libation_auto_refresh_hours = 24
libation_reader_refreshes_per_hour = 3

# Optional readalong sentence synchronization.
alignment_cli_path =

# Optional MP4 faststart conversion (Administration -> Downloaded books).
# Leave blank to look for ffmpeg/ffprobe on PATH; without ffmpeg the control
# is simply disabled. ffprobe verifies each converted file against the original
# before it replaces that file.
# ffmpeg_path =
# ffprobe_path =
