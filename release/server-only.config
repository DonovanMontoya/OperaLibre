# OperaLibre release settings.
#
# This package stores its library and data beside the server executable.
# You can replace these with absolute paths at any time.

# Choose local, lan, or proxy. The profile selects a safe default host;
# advanced deployments can override it with `host`.
deployment_mode = local
host =
port = 4000
allowed_origins =
max_upload_gib = 20
max_book_download_gib = 25
max_concurrent_book_downloads = 1

library_root = audiobooks
data_dir = data
progress_file = data/progress.json
users_file = data/users.json

# The server-only package does not include the web app.
web_dist_dir =

# Optional Libation / Audible import.
libation_cli_path =
libation_files_dir =
libation_auto_refresh_hours = 24
libation_reader_refreshes_per_hour = 3

# Optional readalong sentence synchronization.
alignment_cli_path =
