{
  "name": "@operalibre/web",
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE.md",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "android:sync": "npm run build && cap sync android",
    "android:open": "npm run android:sync && cap open android",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "npm run ios:sync && cap open ios",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint -c .oxlintrc.json src",
    "test:perf": "tsc -p tsconfig.performance.json && playwright test -c playwright.performance.config.ts",
    "test:lifecycle": "tsc -p tsconfig.lifecycle.json && playwright test -c playwright.lifecycle.config.ts",
    "test:follow": "tsc -p tsconfig.follow-along.json && playwright test -c playwright.follow-along.config.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/dialog": "^8.0.1",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/screen-orientation": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capawesome/capacitor-file-picker": "^8.1.0",
    "epubjs": "^0.3.93",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.64.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
